{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Keep the incremental cache inside dist/ so `nest build` (deleteOutDir) wipes both together;
    // a stale cache outside dist/ makes tsc skip emitting and dist/main goes missing.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
