# Copy to server/.env for local development. Never commit the real file.

NODE_ENV=development
PORT=3000
# Public base URL. Locally, use the Vite dev server so the browser stays on one origin.
APP_URL=http://localhost:5173

# Supabase: Project → Connect → "Session pooler" connection string (IPv4-compatible).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# GitHub App (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# base64 of the downloaded .pem:  base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32  (same value goes in the GitHub App's webhook settings)
GITHUB_WEBHOOK_SECRET=

# Optional AI triage: free key from https://console.groq.com (no card). Leave empty to disable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
